{
  "name": "employee-of-the-month",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen": "node content/scripts/gen-index.mjs",
    "setup": "node scripts/setup-keys.mjs",
    "predev": "npm run setup && npm run build",
    "dev": "wrangler dev",
    "predev:web": "npm run gen",
    "dev:web": "vite --config web/vite.config.ts",
    "build:pkg": "npm run build --workspace @narre/llm --workspace @narre/cf",
    "prebuild": "npm run gen && npm run build:pkg",
    "build": "vite build --config web/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "tail": "wrangler tail",
    "pretest": "npm run gen && npm run build:pkg",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/nanum-gothic": "^5.3.0",
    "@narre/cf": "*",
    "@narre/llm": "*",
    "@narre/ui": "*",
    "hono": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "js-yaml": "^5.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.4",
    "vitest": "^2.0.0",
    "wrangler": "^4.114.0"
  }
}
