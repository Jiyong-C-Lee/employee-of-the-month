{
  "name": "employee-of-the-month",
  "routes": [{ "pattern": "eotm.narre.io", "custom_domain": true }],
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    { "binding": "SHARE_KV", "id": "cfe825532dcd405f942e84350b487d05" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DO", "class_name": "RoomDO" },
      { "name": "QUOTA_DO", "class_name": "QuotaDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "QuotaDO"] }],
  "vars": {
    "GEMINI_MODEL": "gemini-flash-lite-latest",
    "NVIDIA_MODEL": "meta/llama-3.3-70b-instruct",
    "LLM_DAILY_LIMIT_GEMINI": "1000",
    "LLM_DAILY_LIMIT_NVIDIA": "5000"
  },
  // dev 환경: 별도 워커(employee-of-the-month-dev, workers.dev 전용)·별도 DO/KV 저장소.
  // LLM 시크릿은 필요 시 `wrangler secret put <이름> --env dev`로 — 없으면 mock 폴백.
  "env": {
    "dev": {
      "workers_dev": true,
      "routes": [],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
      },
      "kv_namespaces": [
        { "binding": "SHARE_KV", "id": "ba1428c26c654a2e844f114942227924" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ROOM_DO", "class_name": "RoomDO" },
          { "name": "QUOTA_DO", "class_name": "QuotaDO" }
        ]
      },
      "vars": {
        "GEMINI_MODEL": "gemini-flash-lite-latest",
        "NVIDIA_MODEL": "meta/llama-3.3-70b-instruct",
        "LLM_DAILY_LIMIT_GEMINI": "1000",
        "LLM_DAILY_LIMIT_NVIDIA": "5000"
      }
    }
  }
}
